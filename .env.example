# 复制为 .env 后按需修改。真实环境变量优先于本文件（见 app/env.py）。
# .env 已被 .gitignore 忽略，不要提交真实密钥。

# 生产必须配：不配就是每次重启换随机密钥，所有 token 失效。
IMAGELABEL_SECRET_KEY=change-me-to-a-long-random-string

IMAGELABEL_DATABASE_URL=sqlite:///./test.db
IMAGELABEL_STORAGE_URI=file://./state/storage

# 前端由本进程同源托管时用不到；单独起静态服务调样式时才配。
# IMAGELABEL_CORS_ORIGINS=http://127.0.0.1:8125

# IMAGELABEL_LOG_LEVEL=INFO

# 自动标注模型（不配也能启动，建任务时会报"模型未配置"）。
IMAGELABEL_LLMDET_DIR=D:\Ideas\onnx-runtime\onnx
IMAGELABEL_LLMDET_PRECISION=fp16
IMAGELABEL_LLMDET_DEVICE=cpu
IMAGELABEL_MARIAN_DIR=D:\Ideas\onnx-runtime\models\opus-mt-zh-en
